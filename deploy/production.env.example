# Inject real values from the deployment platform's secret/config manager.
JHWORKS_ENVIRONMENT=production
JHWORKS_LOG_FORMAT=json
JHWORKS_LOG_LEVEL=INFO
JHWORKS_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
JHWORKS_JWT_SECRET=replace-with-at-least-32-random-characters
JHWORKS_FRONTEND_ORIGIN=https://groupware.example.com
JHWORKS_COOKIE_SECURE=true

# AI remains optional; omit the key to keep deterministic groupware available.
JHWORKS_OPENAI_API_KEY=
JHWORKS_OPENAI_MODEL=gpt-5.4-mini
JHWORKS_POLICY_EMBEDDING_MODEL=text-embedding-3-small
JHWORKS_POLICY_EMBEDDING_DIMENSIONS=1536
JHWORKS_POLICY_RETRIEVAL_TOP_K=4
JHWORKS_POLICY_RETRIEVAL_MIN_SCORE=0.15

JHWORKS_AI_REVIEW_TIMEOUT_SECONDS=20
JHWORKS_APPROVAL_DRAFT_CONFIRMATION_TTL_MINUTES=15
JHWORKS_LEAVE_DRAFT_CONFIRMATION_TTL_MINUTES=15
JHWORKS_LEAVE_SUBMIT_CONFIRMATION_TTL_MINUTES=10

# Web image build argument, not an API runtime secret.
NEXT_PUBLIC_API_URL=https://api.groupware.example.com/api/v1
