# 개발 환경 설정 예시입니다. 실제 키·운영 비밀번호를 이 파일에 넣지 마세요.
# 로컬에서 .env로 복사해 사용하며, .env 파일은 Git에서 제외합니다.
POSTGRES_DB=jhworks
POSTGRES_USER=jhworks
# Docker Compose 로컬 DB 전용 예시 비밀번호 (운영에서 사용 금지)
POSTGRES_PASSWORD=jhworks-local
JHWORKS_JWT_SECRET=replace-with-a-random-secret
JHWORKS_ENVIRONMENT=development
JHWORKS_LOG_FORMAT=json
JHWORKS_LOG_LEVEL=INFO
JHWORKS_DATABASE_URL=sqlite:///./jhworks.db
JHWORKS_FRONTEND_ORIGIN=http://localhost:3000
JHWORKS_COOKIE_SECURE=false
JHWORKS_OPENAI_API_KEY=
JHWORKS_AI_ENABLED=true
# Optional private-mode provider allowlist (JSON); [] disables all paid capabilities.
# JHWORKS_AI_CAPABILITIES=["approval_draft","policy_embedding"]
# Supabase transaction pooler deployments use null + disabled prepared statements.
JHWORKS_DATABASE_POOL_MODE=queue
JHWORKS_DATABASE_DISABLE_PREPARED_STATEMENTS=false
JHWORKS_OPENAI_MODEL=gpt-5.4-mini
JHWORKS_APPROVAL_DRAFT_CONFIRMATION_TTL_MINUTES=15
JHWORKS_LEAVE_DRAFT_CONFIRMATION_TTL_MINUTES=15
JHWORKS_LEAVE_SUBMIT_CONFIRMATION_TTL_MINUTES=10
JHWORKS_AI_REVIEW_TIMEOUT_SECONDS=20
JHWORKS_POLICY_EMBEDDING_MODEL=text-embedding-3-small
JHWORKS_POLICY_EMBEDDING_DIMENSIONS=1536
JHWORKS_POLICY_RETRIEVAL_TOP_K=4
JHWORKS_POLICY_RETRIEVAL_MIN_SCORE=0.15
